.venv/
.conda/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
*.omx

# Cases and gold are built, not committed: `stead bake --all specs` makes both from specs/ and the
# images, identically on every machine. The specs are the source of the benchmark; the trees live in
# the images. Keeping them out also keeps image_digest churn out of every diff.
cases/
gold/
results/
dist/
*.fst
*.vcd
*.log
!tests/fixtures/**
tests/fixtures/**/__pycache__/
# Local notes: AGENTS.md, python_rules.md, the plan. Only the README is public.
/*.md
!/README.md
