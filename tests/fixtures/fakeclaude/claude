#!/bin/bash
# Fake `claude -p --output-format json`: records its argv and cwd, answers with a canned submission.
printf '%s\n' "$PWD" "$@" > "${FAKECLAUDE_LOG:-/dev/null}"
cat <<'JSON'
{"type":"result","is_error":false,"num_turns":4,"duration_ms":30000,"total_cost_usd":0.5,
 "result":"The XOR result has bit 4 flipped.\n\n```json\n{\"k\": 2, \"lines\": [{\"file\": \"rtl/alu.sv\", \"line\": 2, \"confidence\": 0.9}, {\"file\": \"rtl/alu.sv\", \"line\": 1, \"confidence\": 0.1}], \"patch\": null, \"text\": \"bit 4 of the XOR result is flipped\"}\n```"}
JSON
