     endcase
 end
 
+//-------------------------------------------------------------------------------
+// STEAD write tracker
+//-------------------------------------------------------------------------------
+// Per byte of memory, the last dmem write that landed there: bus time, the full
+// hwdata word and byte enables of that data phase. Sampled on the falling edge
+// of the accepted data phase, where hwdata is stable, so a dump opened at
+// stead_wr_time[] shows stead_wr_data[] on the port.
+localparam                      STEAD_TRACK_SIZE = 65536;
+time                            stead_wr_time [0:STEAD_TRACK_SIZE-1];
+logic [SCR1_AHB_WIDTH-1:0]      stead_wr_data [0:STEAD_TRACK_SIZE-1];
+logic [3:0]                     stead_wr_strb [0:STEAD_TRACK_SIZE-1];
+logic [SCR1_AHB_WIDTH-1:0]      stead_adr;
+
+always @(negedge clk) begin
+    if (rst_n & (dmem_ahb_state == SCR1_AHB_STATE_DATA) & dmem_req_ack & dmem_ahb_wr) begin
+        stead_adr = {dmem_ahb_addr[SCR1_AHB_WIDTH-1:2], 2'b00};
+        for (int i = 0; i < 4; ++i) begin
+            if (dmem_ahb_be[i] && ((stead_adr + i) < STEAD_TRACK_SIZE)) begin
+                stead_wr_time[stead_adr + i] = $time;
+                stead_wr_data[stead_adr + i] = dmem_hwdata;
+                stead_wr_strb[stead_adr + i] = dmem_ahb_be;
+            end
+        end
+    end
+end
+
