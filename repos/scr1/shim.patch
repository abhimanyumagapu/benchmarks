index e6d6fe1..e3071b7 100644
--- a/src/tb/scr1_memory_tb_axi.sv
+++ b/src/tb/scr1_memory_tb_axi.sv
@@ -86,6 +86,40 @@ string                                      test_file;
 `endif // VERILATOR
 bit                                         test_file_init;
 
+//-------------------------------------------------------------------------------
+// STEAD write tracker
+//-------------------------------------------------------------------------------
+// Per byte of memory, the last dmem write that landed there: bus time, the full
+// wdata word and strobes of that beat. Sampled on the falling edge, where the
+// beat the next rising edge accepts is stable, so a dump opened at
+// stead_wr_time[] shows stead_wr_data[] on the wdata port.
+localparam                                  STEAD_TRACK_SIZE = 65536;
+time                                        stead_wr_time [0:STEAD_TRACK_SIZE-1];
+logic  [W_DATA-1:0]                         stead_wr_data [0:STEAD_TRACK_SIZE-1];
+logic  [W_DATA/8-1:0]                       stead_wr_strb [0:STEAD_TRACK_SIZE-1];
+logic  [W_ADR-1:0]                          stead_adr;
+int                                         stead_lane;
+int                                         stead_nbytes;
+
+always @(negedge clk) begin
+    if (rst_n & wvalid[0] & wready[0] & wlast[0]) begin // interface 0 is dmem; imem never writes
+        // Same address/size/lane selection as mem_write()
+        stead_adr    = awready[0] ? awaddr[0] : awaddr_hold[0];
+        stead_nbytes = 2**(awready[0] ? awsize[0] : awsize_hold[0]);
+        stead_lane   = 0;
+        for (int i = 0; i < $clog2(W_DATA/8); ++i) stead_lane[i] = stead_adr[i];
+        for (int i = stead_lane; (i < W_DATA/8) && (stead_nbytes != 0); ++i) begin
+            if (wstrb[0][i] && (stead_adr < STEAD_TRACK_SIZE)) begin
+                stead_wr_time[stead_adr] = $time;
+                stead_wr_data[stead_adr] = wdata[0];
+                stead_wr_strb[stead_adr] = wstrb[0];
+            end
+            stead_adr    = stead_adr + 1'b1;
+            stead_nbytes = stead_nbytes - 1;
+        end
+    end
+end
+
